# AI Infra Doctor - 环境变量样例
#
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不要提交到 Git。
#
# 三个变量都必须配置才能调用大模型。
# 支持 OpenAI 兼容协议的服务商都可以，换服务商只需改 AI_BASE_URL 和 AI_MODEL。

# 模型服务的 API Key
AI_API_KEY=your-api-key-here

# OpenAI 兼容接口地址（注意通常要带 /v1）
#   OpenAI  : https://api.openai.com/v1
#   DeepSeek: https://api.deepseek.com/v1
#   MiniMax : https://api.minimax.chat/v1
#   本地推理: http://127.0.0.1:8000/v1
AI_BASE_URL=https://api.openai.com/v1

# 模型名称
AI_MODEL=gpt-4o-mini
